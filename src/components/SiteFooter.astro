---
import {copy} from '../site/index';import {routeFor,type Locale,type PageId} from '../site/model';
interface Props {locale:Locale;pageId:PageId}
const {locale}=Astro.props;const t=copy[locale];
const mainSiteLabel={en:'AirDB main website','zh-hans':'AirDB 主站','zh-hant':'AirDB 主站'};
const siteRole={en:'This website explores digital-finance technology.','zh-hans':'本网站聚焦数字金融技术探索。','zh-hant':'本網站聚焦數位金融技術探索。'};
---
<footer class="site-footer"><div class="shell"><div class="footer-top"><a class="brand" href={routeFor(locale,'home')}>air<span>db</span><small>HONG<br/>KONG</small></a><nav aria-label={locale==='en'?'Footer':'页脚 / 頁腳'}><a href={routeFor(locale,'trust')}>{locale==='en'?'Trust & boundaries':locale==='zh-hans'?'信任与边界':'信任與邊界'}</a><a href={routeFor(locale,'company')}>{t.nav.company}</a><a href="https://airdb.com/" target="_blank" rel="noopener noreferrer">{mainSiteLabel[locale]} ↗</a><a href="https://airdb.group" target="_blank" rel="noopener noreferrer">AirDB Group ↗</a></nav></div><p class="legal">{siteRole[locale]} {t.ui.legal}</p><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} AirDB</span><a href="mailto:info@airdb.com">info@airdb.com</a><a href="#top">{t.ui.top} ↑</a></div></div></footer>
