---
import { locales, type Locale } from '../content';
import '../styles/product.css';
import '../styles/hk.css';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = locales[locale];
const ids = ['scenarios','infrastructure','protocol','roadmap'];
const langs = [{key:'en',label:'EN',path:'/'},{key:'zh-hant',label:'繁',path:'/zh-hant/'},{key:'zh-hans',label:'简',path:'/zh-hans/'}];
const site = new URL('https://airdb.hk');
const contact = 'mailto:info@airdb.com?subject=AirDB%20Hong%20Kong%20%E2%80%94%20Payment%20integration';
---
<!doctype html>
<html lang={t.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title}</title><meta name="description" content={t.description} />
  <link rel="canonical" href={new URL(t.path,site)} />
  {Object.values(locales).map(l => <link rel="alternate" hreflang={l.lang} href={new URL(l.path,site)} />)}
  <link rel="alternate" hreflang="x-default" href={site} />
  <meta property="og:title" content={t.title} /><meta property="og:description" content={t.description} />
  <meta property="og:type" content="website" /><meta property="og:url" content={new URL(t.path,site)} />
  <meta name="theme-color" content="#17281d" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/ibm-plex-sans-var-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fraunces-var-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body id="top">
  <a class="skip-link" href="#main">{locale === 'en' ? 'Skip to content' : locale === 'zh-hant' ? '跳至內容' : '跳至内容'}</a>
  <header class="hk-header">
    <div class="shell hk-header-inner">
      <a href={t.path} class="hk-brand" aria-label="AirDB Hong Kong"><span class="brand-symbol" aria-hidden="true">▚</span>air<span>db</span><small>HONG KONG</small></a>
      <nav class="desktop-nav" aria-label={locale === 'en' ? 'Primary navigation' : locale === 'zh-hant' ? '導覽' : '导航'}>{t.nav.map((label,i) => <a href={`#${ids[i]}`}>{label}</a>)}</nav>
      <div class="header-right"><nav class="languages" aria-label="Language">{langs.map(l => <a href={l.path} lang={locales[l.key as Locale].lang} aria-current={l.key===locale ? 'page' : undefined}>{l.label}</a>)}</nav><a class="contact-link" href={contact}>{t.contact}<span aria-hidden="true"> ↗</span></a></div>
      <details class="mobile-nav"><summary>{t.menu}</summary><nav aria-label={t.menu}>{t.nav.map((label,i)=><a href={`#${ids[i]}`}>{label}</a>)}<a href={contact}>{t.contact}</a></nav></details>
    </div>
  </header>
  <main id="main" tabindex="-1">
    <section class="hk-hero shell">
      <div class="hero-text"><h1>{t.hero[0]}<br/><em>{t.hero[1]}</em></h1><p class="hero-description">{t.intro}</p><div class="hero-buttons"><a class="hk-button" href="#scenarios">{t.primary}<span aria-hidden="true"> ↗</span></a><a class="text-link" href={contact}>{t.secondary}<span aria-hidden="true"> →</span></a></div><p class="development-note"><span aria-hidden="true"></span>{t.notice}</p></div>
      <figure class="payment-map"><figcaption>{t.graphicTitle}</figcaption><div class="map-top"><span>22.3193° N</span><span>114.1694° E</span></div><div class="map-orbit" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="map-center">HK<span>airdb</span></div><span class="map-node node-one"></span><span class="map-node node-two"></span><span class="map-node node-three"></span></div><div class="network-labels">{t.network.map((label,i)=><span><b>0{i+1}</b>{label}</span>)}</div><ol class="payment-chain">{t.graph.map((label,i)=><li><span>0{i+1}</span>{label}</li>)}</ol><p class="figure-note">{t.graphicNote}</p></figure>
    </section>
    <div class="scope-rail"><div class="shell">{t.rail.map(label=><span>{label}</span>)}<span class="rail-signature">AIRDB.HK / PROGRAMMABLE PAYMENTS</span></div></div>
    <section id="scenarios" class="shell hk-section"><p class="section-index">{t.scenarioLabel}</p><h2>{t.scenarioTitle}</h2><div class="scenario-grid">{t.scenarios.map(([title,copy,flow],i)=><article class="scenario"><span class="scenario-number">0{i+1}</span><h3>{title}</h3><p>{copy}</p><p class="scenario-flow">{flow}</p></article>)}</div></section>
    <section id="infrastructure" class="control-section"><div class="shell control-grid"><div><p class="section-index">{t.infraLabel}</p><h2>{t.infraTitle}</h2><p class="section-intro">{t.infraIntro}</p><dl class="controls">{t.controls.map(([title,copy])=><div><dt>{title}</dt><dd>{copy}</dd></div>)}</dl></div><aside class="policy"><div class="policy-header"><span class="policy-icon" aria-hidden="true">▚</span><span>AGENT / POLICY</span><span>01</span></div><h3>{t.policyTitle}</h3><dl>{t.policyRows.map(([key,value])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl><p>{t.policyNote}</p></aside></div></section>
    <section id="protocol" class="shell hk-section"><p class="section-index">{t.protocolLabel}</p><div class="protocol-heading"><h2>{t.protocolTitle.split('\n').map(line=><span>{line}<br/></span>)}</h2><p class="section-intro">{t.protocolIntro}</p></div><div class="protocol-grid"><ol class="protocol-steps">{t.steps.map(([title,copy],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol><div class="exchange"><div class="exchange-bar"><span>{t.codeLabel}</span><span>HTTP / 402</span></div><pre><code><span class="code-comment"># 01 / request a resource</span>{'\n'}GET /example/compute{'\n\n'}<span class="code-comment"># 02 / service requests payment</span>{'\n'}HTTP/1.1 <span class="code-accent">402 Payment Required</span>{'\n'}PAYMENT-REQUIRED: &lt;requirements&gt;{'\n\n'}<span class="code-comment"># 03 / retry with authorization</span>{'\n'}GET /example/compute{'\n'}PAYMENT-SIGNATURE: &lt;authorization&gt;{'\n\n'}<span class="code-comment"># 04 / verified payment, resource delivered</span>{'\n'}HTTP/1.1 <span class="code-accent">200 OK</span>{'\n'}PAYMENT-RESPONSE: &lt;result&gt;</code></pre></div></div><div class="protocol-footnote"><p>{t.protocolNote}</p><a class="text-link" href="https://github.com/x402-foundation/x402/blob/main/specs/transports-v2/http.md" target="_blank" rel="noopener noreferrer">{t.protocolLink} ↗</a></div></section>
    <section id="roadmap" class="roadmap-section"><div class="shell"><p class="section-index">{t.roadmapLabel}</p><h2>{t.roadmapTitle}</h2><ol class="roadmap">{t.roadmap.map(([state,title,copy],i)=><li><span class="roadmap-state"><i aria-hidden="true" class:list={{active:i===0}}></i>{state}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>
    <section id="contact" class="shell closing"><div><h2>{t.closing}</h2><p>{t.closingBody}</p></div><a class="hk-button" href={contact}>{t.contact} ↗</a></section>
  </main>
  <footer class="hk-footer"><div class="shell"><div class="footer-top"><a href={t.path} class="hk-brand">air<span>db</span><small>HONG KONG</small></a><p>{t.footer}</p><a href="https://airdb.group">AirDB Group ↗</a></div><p class="legal">{t.legal}</p><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} AirDB</span><a href="mailto:info@airdb.com">info@airdb.com</a><a href="#top">{t.top} ↑</a></div></div></footer>
</body>
</html>
