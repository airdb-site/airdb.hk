---
import {copy} from '../site/index';import {routeFor,capabilityStates,type Locale,type CapabilityId} from '../site/model';
import SiteLayout from '../layouts/SiteLayout.astro';import CapabilityCard from './CapabilityCard.astro';import FlowDiagram from './FlowDiagram.astro';
interface Props {locale:Locale}
const {locale}=Astro.props;const t=copy[locale];const p=t.pages.home;const [problem,platform,audience,closing]=p.sections;
---
<SiteLayout locale={locale} pageId="home">
<section class="shell hero"><div class="hero-copy"><h1>{p.heading}</h1><p class="lead">{p.intro}</p><div class="actions"><a class="button" href={routeFor(locale,'solutions')}>{t.ui.primary} <span aria-hidden="true">↗</span></a><a class="text-link" href={routeFor(locale,'company')+'#contact'}>{t.ui.secondary} <span aria-hidden="true">→</span></a></div><p class="development-note">{t.ui.notice}</p></div><FlowDiagram locale={locale}/></section>
<div class="scope-rail"><div class="shell"><span>HONG KONG</span><span>{locale==='en'?'CROSS-BORDER TRADE':locale==='zh-hans'?'跨境贸易支付':'跨境貿易支付'}</span><span>AGENT ECONOMY</span><span class="rail-end">AIRDB.HK</span></div></div>
<section class="shell section problem"><p class="section-index">01 / {t.ui.vision}</p><div class="split"><h2>{problem.title}</h2><p class="lead">{problem.paragraphs[0]}</p></div></section>
<section id="infrastructure" class="tinted section"><div class="shell"><p class="section-index">02 / {t.nav.platform}</p><div class="section-heading"><h2>{platform.title}</h2><p>{platform.paragraphs[0]}</p></div><div class="capability-grid">{(Object.keys(capabilityStates) as CapabilityId[]).map(id=><CapabilityCard locale={locale} id={id}/>)}</div></div></section>
<section id="scenarios" class="shell section"><p class="section-index">03 / {t.nav.solutions}</p><div class="section-heading"><h2>{audience.title}</h2><p>{audience.paragraphs[0]}</p></div><div class="audience-grid">{t.pages.solutions.sections.slice(0,2).map((s,i)=><article><span class="audience-number" aria-hidden="true">0{i+1}</span><h3><a href={routeFor(locale,'solutions')+'#'+s.id}>{s.title} <span aria-hidden="true">↗</span></a></h3><p>{s.paragraphs[0]}</p><a class="text-link" href={routeFor(locale,'solutions')+'#'+s.id}>{locale==='en'?'See the proposed workflow':locale==='zh-hans'?'查看完整流程':'查看完整流程'} →</a></article>)}</div></section>
<section id="protocol" class="research-feature"><div class="shell"><div><p class="section-index">04 / {t.ui.research}</p><h2><a href={routeFor(locale,'article')}>{t.pages.article.heading}</a></h2></div><div class="research-summary"><p>{t.pages.article.intro}</p><a class="text-link" href={routeFor(locale,'article')}>{t.ui.read} <span aria-hidden="true">↗</span></a><a class="sub-link" href={routeFor(locale,'developers')+'#protocol'}>x402 · {t.nav.developers} →</a></div></div></section>
<section id="roadmap" class="shell section"><p class="section-index">05 / {t.pages.trust.heading}</p><div class="split"><div><h2>{t.pages.platform.sections[0].title}</h2><a class="text-link" href={routeFor(locale,'trust')}>{t.pages.trust.heading} ↗</a></div><div><p class="lead">{t.pages.platform.sections[0].paragraphs[0]}</p><a class="text-link" href={routeFor(locale,'platform')+'#roadmap'}>{t.nav.platform} →</a></div></div></section>
<section id="contact" class="closing"><div class="shell"><div><h2>{closing.title}</h2><p>{closing.paragraphs[0]}</p></div><div class="closing-options">{t.pages.solutions.sections.filter(s=>s.caseStudy).map(s=><a class="button" href={routeFor(locale,'company')+'#contact-'+s.id}>{s.caseStudy!.cta} ↗</a>)}</div></div></section>
</SiteLayout>
