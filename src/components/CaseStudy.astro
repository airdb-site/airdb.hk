---
import type { Locale, Section } from '../site/model';
import { routeFor } from '../site/model';
interface Props { locale: Locale; section: Section }
const {locale,section:s}=Astro.props;
const c=s.caseStudy!;
---
<section id={s.id} class="case-study">
  <header class="case-heading"><p class="section-index">{c.label}</p><h2>{s.title}</h2><p class="lead">{s.paragraphs[0]}</p></header>
  <div class="case-layout"><div><h3>{c.stepsLabel}</h3><ol class="case-steps">{s.bullets?.map((step,i)=><li><span aria-hidden="true">0{i+1}</span><p>{step}</p></li>)}</ol></div>
  <aside class="case-outcome"><h3>{c.resultLabel}</h3><p>{s.paragraphs[1]}</p><h3>{c.exceptionLabel}</h3><p>{c.exception}</p><a class="text-link" href={routeFor(locale,'company')+'#contact-'+s.id}>{c.cta} ↗</a></aside></div>
</section>
