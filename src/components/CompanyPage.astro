---
import {copy} from '../site/index';import {routeFor,capabilityStates,type Locale,type PageId,type CapabilityId} from '../site/model';
import SiteLayout from '../layouts/SiteLayout.astro';import StatusBadge from './StatusBadge.astro';import FlowDiagram from './FlowDiagram.astro';
interface Props {locale:Locale;pageId:Exclude<PageId,'home'|'article'>}
const {locale,pageId}=Astro.props;const t=copy[locale];const p=t.pages[pageId];
const protocol=`# Illustrative exchange — not a production API\nGET /example/compute\n\nHTTP/1.1 402 Payment Required\nPAYMENT-REQUIRED: <requirements>\n\nGET /example/compute\nPAYMENT-SIGNATURE: <authorization>\n\nHTTP/1.1 200 OK\nPAYMENT-RESPONSE: <result>`;
---
<SiteLayout locale={locale} pageId={pageId}>
<div class="shell"><header class="page-hero"><h1>{p.heading}</h1><p class="lead">{p.intro}</p><p class="development-note">{t.ui.notice}</p></header>
<div class="page-body">
{pageId==='platform'&&<><div class="platform-overview"><FlowDiagram locale={locale}/><div><p class="lead">{t.pages.trust.intro}</p><a class="text-link" href={routeFor(locale,'trust')}>{t.pages.trust.heading} ↗</a></div></div>{(Object.keys(capabilityStates) as CapabilityId[]).map(id=><section id={id} class="content-row capability-detail"><div><StatusBadge locale={locale} status={capabilityStates[id]}/><h2>{t.capabilities[id].title}</h2></div><div><p>{t.capabilities[id].summary}</p><p class="flow-caption">{t.capabilities[id].input} → {t.capabilities[id].output}</p>{t.capabilities[id].boundaries.map(b=><p class="boundary">{b}</p>)}</div></section>)}</>}
{pageId==='research'&&<article class="research-link"><p class="section-index">{t.ui.research}</p><h2><a href={routeFor(locale,'article')}>{t.pages.article.heading}</a></h2><p>{t.pages.article.intro}</p><a class="text-link" href={routeFor(locale,'article')}>{t.ui.read} ↗</a></article>}
{p.sections.map(s=><><section class="content-row" id={s.id}><h2>{s.title}</h2><div>{s.paragraphs.map(text=><p>{text}</p>)}{s.bullets&&<ul>{s.bullets.map(b=><li>{b}</li>)}</ul>}{s.id==='contact'&&<p><a class="button" href="mailto:info@airdb.com">info@airdb.com ↗</a></p>}</div></section>{pageId==='developers'&&s.id==='protocol'&&<><div class="protocol-example"><p>{locale==='en'?'SIMULATED EXCHANGE · NOT A PRODUCTION INTERFACE':locale==='zh-hans'?'模拟交互 · 不可作为生产接口':'模擬交互 · 不可作為生產介面'}</p><pre tabindex="0"><code>{protocol}</code></pre></div><p class="protocol-source"><a class="text-link" href="https://github.com/x402-foundation/x402/blob/main/specs/transports-v2/http.md" target="_blank" rel="noopener noreferrer">{locale==='en'?'Read the x402 specification':locale==='zh-hans'?'阅读 x402 协议规范':'閱讀 x402 協議規範'} ↗</a></p></>}</>)}
{pageId!=='company'&&<div class="page-contact"><p>{t.pages.company.sections[3].paragraphs[0]}</p><a class="button" href={routeFor(locale,'company')+'#contact'}>{t.ui.contact} ↗</a></div>}
</div></div>
</SiteLayout>
